meta {
  name: Refresh Token
  type: http
  seq: 8
}

post {
  url: {{baseurl}}/token
  body: json
  auth: none
}

body:json {
  {
    "grant_type": "refresh_token",
    "client_id": "{{client_id}}",
    "refresh_token": "{{refresh_token}}"
  }
}

vars:post-response {
  access_token: res.body.access_token
  id_token: res.body.id_token
  refresh_token: res.body.refresh_token
}

assert {
  res.status: eq 200
  res.body.access_token: isNotEmpty
  res.body.id_token: isNotEmpty
  res.body.token_type: eq Bearer
  res.body.refresh_token: isNotEmpty
}

settings {
  encodeUrl: true
  timeout: 0
}
